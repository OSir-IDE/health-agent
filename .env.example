# Copia in .env e compila. NON committare .env
GARMIN_EMAIL=
GARMIN_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HISTORY_PATH=data/history.csv
WEATHER_CITY=Roma
WEATHER_LAT=41.89
WEATHER_LON=12.49
SUGGESTIONS_LOG_PATH=data/suggestions_log.csv
QUOTES_LOG_PATH=data/quotes_log.csv
USER_SUGGESTIONS_PATH=data/user_suggestions.json
# --- Sonno ---
SLEEP_MIN_HOURS=7
# --- LLM locale (Ollama) ---
LLM_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b
OLLAMA_TIMEOUT=180
# secondi di attesa all'avvio perché Ollama risponda (dopo accensione/risveglio può non essere pronto)
OLLAMA_WAIT_SECONDS=120
LLM_LOG_PATH=data/llm_log.jsonl
RUN_LOG_PATH=data/run.log
# --- Giornale ---
NEWS_ENABLED=true
NEWS_TOP=3
NEWS_PERSONAL=5
NEWS_LOG_PATH=data/news_log.json
NEWS_PER_SOURCE=25          # al massimo N articoli (i più recenti) per fonte
NEWS_NARRATIVE=true         # "Il filo del giorno" (richiede LLM_ENABLED=true)
# Raggruppamento semantico (embedding via Ollama). Soglie da tarare con tools/diagnostica_notizie.py
NEWS_SEMANTIC=true
NEWS_EMBED_MODEL=bge-m3
NEWS_EMB_SIMILARITY=0.70    # sopra: due articoli sono la stessa storia
NEWS_EMB_DIVERSITY=0.62     # sopra: due storie scelte sono troppo simili per comparire entrambe
# Riserva se Ollama non risponde (confronto a frammenti di caratteri)
NEWS_SIMILARITY=0.21
NEWS_DIVERSITY=0.12
# Archivio per lo sfondo della narrazione
NEWS_ARCHIVE=true
NEWS_ARCHIVE_MIN_DAYS=7     # lo sfondo si attiva dopo N giorni di archivio
NEWS_ARCHIVE_SIMILARITY=0.70
# --- Pulsanti, settimanale, corsa ---
FEEDBACK_BUTTONS=false      # true = 👍/👎 sotto il giornale (letti dal task ogni 30 min). Spenti per scelta
FEEDBACK_REC_BUTTONS=false  # true (con FEEDBACK_BUTTONS=true) = ✅/✖ anche sui consigli del report
FEEDBACK_DB=data/feedback.sqlite
FEEDBACK_STEP=0.15          # quanto spostano i pesi dei temi i tuoi voti (0,15 per voto netto, max ±4)
WEEKLY_ENABLED=true
WEEKLY_DAY=6                # 0=lunedì … 6=domenica
RUNNING_ENABLED=true
RUNS_PATH=data/runs.csv
REPORT_NOT_BEFORE=7        # ora locale: prima di questa il task non invia il report (dati Garmin non ancora sincronizzati)
